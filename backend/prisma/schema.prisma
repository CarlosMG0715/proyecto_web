generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupRole {
  ADMIN
  MIEMBRO
}

enum PenaltyStatus {
  PENDING
  RESOLVED
  WAIVED
}

enum MessageType {
  USER
  SYSTEM
}

enum ContextType {
  CHECK_IN
  PENALTY
  DROPOUT_RISK
  DAILY_CLOSURE
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                  String             @id @default(cuid())
  name                String
  email               String             @unique
  passwordHash        String
  characterId         String             @default("sprout")
  themeId             String             @default("sprout")
  joinRequests        GroupJoinRequest[] @relation("JoinRequester")
  handledJoinRequests GroupJoinRequest[] @relation("JoinDecisionMaker")
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  memberships         GroupMembership[]
  createdGroups       Group[]            @relation("GroupCreator")
  createdHabits       Habit[]            @relation("HabitCreator")
  checkIns            CheckIn[]
  penalties           Penalty[]
  messages            Message[]
  sessions            Session[]
  dropoutRisks        DropoutRisk[]

  @@map("users")
}

model Group {
  id               String             @id @default(cuid())
  name             String
  inviteCode       String             @unique
  timeZone         String             @default("America/Bogota")
  penaltyThreshold Float              @default(0.6)
  version          Int                @default(0)
  createdById      String
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  createdBy        User               @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships      GroupMembership[]
  joinRequests     GroupJoinRequest[]
  category         String             @default("General")
  color            String             @default("#8b5cf6")
  habits           Habit[]
  penalties        Penalty[]
  messages         Message[]
  closures         DailyClosure[]
  dropoutRisks     DropoutRisk[]

  @@index([createdById])
  @@map("groups")
}

model GroupMembership {
  id       String    @id @default(cuid())
  groupId  String
  userId   String
  role     GroupRole @default(MIEMBRO)
  joinedAt DateTime  @default(now()) @db.Timestamptz(3)
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_memberships")
}

model Habit {
  id          String    @id @default(cuid())
  groupId     String
  createdById String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("HabitCreator", fields: [createdById], references: [id], onDelete: Restrict)
  checkIns    CheckIn[]
  penalties   Penalty[]

  @@index([groupId, isActive])
  @@index([createdById])
  @@map("habits")
}

model CheckIn {
  id          String   @id @default(cuid())
  habitId     String
  userId      String
  checkInDate DateTime @db.Date
  checkedAt   DateTime @default(now()) @db.Timestamptz(3)
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, userId, checkInDate])
  @@index([userId, checkInDate])
  @@map("check_ins")
}

model DailyClosure {
  id                String    @id @default(cuid())
  groupId           String
  localDate         DateTime  @db.Date
  expectedCheckIns  Int
  completedCheckIns Int
  completionRate    Float
  penaltyApplied    Boolean   @default(false)
  processedAt       DateTime  @default(now()) @db.Timestamptz(3)
  group             Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  penalties         Penalty[]

  @@unique([groupId, localDate])
  @@index([groupId, processedAt])
  @@map("daily_closures")
}

model Penalty {
  id             String        @id @default(cuid())
  groupId        String
  userId         String
  habitId        String?
  closureId      String?
  idempotencyKey String        @unique
  reason         String
  points         Int           @default(1)
  status         PenaltyStatus @default(PENDING)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  group          Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit          Habit?        @relation(fields: [habitId], references: [id], onDelete: SetNull)
  closure        DailyClosure? @relation(fields: [closureId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([userId, status])
  @@index([closureId])
  @@map("penalties")
}

model DropoutRisk {
  id                String     @id @default(cuid())
  groupId           String
  userId            String
  score             Float
  level             RiskLevel  @default(LOW)
  consecutiveMisses Int        @default(0)
  recentRate        Float      @default(0)
  previousRate      Float      @default(0)
  lastNotifiedLevel RiskLevel?
  computedAt        DateTime   @default(now()) @db.Timestamptz(3)
  group             Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, level])
  @@map("dropout_risks")
}

model Message {
  id          String       @id @default(cuid())
  groupId     String
  userId      String?
  type        MessageType  @default(USER)
  content     String
  contextType ContextType?
  contextId   String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
  @@index([contextType, contextId])
  @@map("messages")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  familyId     String    @default(cuid())
  tokenHash    String    @unique
  replacedById String?
  userAgent    String?
  ipAddress    String?
  isRevoked    Boolean   @default(false)
  revokedAt    DateTime? @db.Timestamptz(3)
  lastUsedAt   DateTime? @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([familyId])
  @@map("sessions")
}

enum JoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model GroupJoinRequest {
  id          String            @id @default(cuid())
  groupId     String
  requesterId String
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  decidedAt   DateTime?         @db.Timestamptz(3)
  decidedById String?
  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requester   User              @relation("JoinRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy   User?             @relation("JoinDecisionMaker", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([groupId, status, createdAt])
  @@index([requesterId, status])
  @@map("group_join_requests")
}
