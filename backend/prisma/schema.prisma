// prisma lee este esquema para crear tablas y generar el cliente de javascript.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolGrupo {
  ADMIN
  MIEMBRO

  @@map("GroupRole")
}

enum TipoMensaje {
  USER
  SYSTEM

  @@map("MessageType")
}

enum TipoContexto {
  HABIT_CREATED
  CHECK_IN
  PENALTY
  DROPOUT_RISK
  DAILY_CLOSURE

  @@map("ContextType")
}

enum NivelRiesgo {
  LOW
  MEDIUM
  HIGH

  @@map("RiskLevel")
}

model Usuario {
  // cuenta de la persona y sus relaciones con actividad del sistema.
  id String            @id @default(cuid())
  name String
  email String            @unique
  hashContrasena String @map("passwordHash")
  idPersonaje String            @default("sprout") @map("characterId")
  idTema String            @default("sprout") @map("themeId")
  creadoEn DateTime          @default(now()) @db.Timestamptz(3) @map("createdAt")
  actualizadoEn DateTime          @updatedAt @db.Timestamptz(3) @map("updatedAt")
  membresias MembresiaGrupo[]
  gruposCreados Grupo[]           @relation("GroupCreator")
  habitosCreados Habito[]           @relation("HabitCreator")
  registrosHabito RegistroHabito[]
  penalizaciones Penalizacion[]
  messages Mensaje[]
  sessions Sesion[]
  riesgosDesercion RiesgoDesercion[]
  solicitudesEnviadas SolicitudIngreso[]

  @@map("users")
}

model Grupo {
  descripcion String @default("")
  // espacio compartido; la zona horaria define el dia de check-in.
  id String            @id @default(cuid())
  name String
  codigoInvitacion String            @unique @map("inviteCode")
  timeZone String            @default("America/Bogota")
  version Int               @default(0)
  idCreador String @map("createdById")
  creadoEn DateTime          @default(now()) @db.Timestamptz(3) @map("createdAt")
  actualizadoEn DateTime          @updatedAt @db.Timestamptz(3) @map("updatedAt")
  creador Usuario              @relation("GroupCreator", fields: [idCreador], references: [id], onDelete: Restrict)
  membresias MembresiaGrupo[]
  habits Habito[]
  penalizaciones Penalizacion[]
  messages Mensaje[]
  cierres CierreDiario[]
  riesgosDesercion RiesgoDesercion[]
  solicitudesIngreso SolicitudIngreso[]
  color String            @default("#8b5cf6")

  @@index([idCreador])
  @@map("groups")
}

model MembresiaGrupo {
  // union entre cuenta y grupo, con rol y fecha de ingreso.
  id String    @id @default(cuid())
  idGrupo String @map("groupId")
  idUsuario String @map("userId")
  role RolGrupo @default(MIEMBRO)
  ingresoEn DateTime  @default(now()) @db.Timestamptz(3) @map("joinedAt")
  caidoEn DateTime? @db.Timestamptz(3) @map("fallenAt")
  group Grupo     @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  user Usuario      @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@unique([idGrupo, idUsuario])
  @@index([idUsuario])
  @@map("group_memberships")
}

model SolicitudIngreso {
  id String @id @default(cuid())
  idGrupo String @map("groupId")
  idUsuario String @map("requesterId")
  creadoEn DateTime @default(now()) @db.Timestamptz(3) @map("createdAt")
  grupo Grupo @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@unique([idGrupo, idUsuario])
  @@index([idGrupo, creadoEn])
  @@map("group_join_requests")
}

model Habito {
  insignia String @default("target")
  // meta compartida que los miembros pueden completar cada dia.
  id String    @id @default(cuid())
  idGrupo String @map("groupId")
  idCreador String @map("createdById")
  name String
  description String?
  diasMeta Int       @default(30) @map("targetDays")
  activo Boolean   @default(true) @map("isActive")
  creadoEn DateTime  @default(now()) @db.Timestamptz(3) @map("createdAt")
  actualizadoEn DateTime  @updatedAt @db.Timestamptz(3) @map("updatedAt")
  group Grupo     @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  creador Usuario      @relation("HabitCreator", fields: [idCreador], references: [id], onDelete: Restrict)
  registrosHabito RegistroHabito[]

  @@index([idGrupo, activo])
  @@index([idCreador])
  @@map("habits")
}

model RegistroHabito {
  mensaje String @default("")
  // cumplimiento diario unico por persona y habito, .
  id String   @id @default(cuid())
  idHabito String @map("habitId")
  idUsuario String @map("userId")
  fechaRegistro DateTime @db.Date @map("checkInDate")
  registradoEn DateTime @default(now()) @db.Timestamptz(3) @map("checkedAt")
  habit Habito    @relation(fields: [idHabito], references: [id], onDelete: Cascade)
  user Usuario     @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@unique([idHabito, idUsuario, fechaRegistro])
  @@index([idUsuario, fechaRegistro])
  @@map("check_ins")
}

model CierreDiario {
  id String    @id @default(cuid())
  idGrupo String @map("groupId")
  fechaLocal DateTime  @db.Date @map("localDate")
  registrosEsperados Int @map("expectedCheckIns")
  registrosCompletados Int @map("completedCheckIns")
  tasaCumplimiento Float @map("completionRate")
  penalizacionAplicada Boolean   @default(false) @map("penaltyApplied")
  procesadoEn DateTime  @default(now()) @db.Timestamptz(3) @map("processedAt")
  group Grupo     @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  penalizaciones Penalizacion[]

  @@unique([idGrupo, fechaLocal])
  @@index([idGrupo, procesadoEn])
  @@map("daily_closures")
}

model Penalizacion {
  id String        @id @default(cuid())
  idGrupo String @map("groupId")
  idUsuario String @map("userId")
  idCierre String? @map("closureId")
  claveUnica String        @unique @map("idempotencyKey")
  reason String
  creadoEn DateTime      @default(now()) @db.Timestamptz(3) @map("createdAt")
  group Grupo         @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  user Usuario          @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  closure CierreDiario? @relation(fields: [idCierre], references: [id], onDelete: SetNull)

  @@index([idGrupo, creadoEn])
  @@index([idUsuario])
  @@index([idCierre])
  @@map("penalties")
}

model RiesgoDesercion {
  id String    @id @default(cuid())
  idGrupo String @map("groupId")
  idUsuario String @map("userId")
  level NivelRiesgo @default(LOW)
  ausenciasConsecutivas Int       @default(0) @map("consecutiveMisses")
  calculadoEn DateTime  @default(now()) @db.Timestamptz(3) @map("computedAt")
  group Grupo     @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  user Usuario      @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@unique([idGrupo, idUsuario])
  @@index([idGrupo, level])
  @@map("dropout_risks")
}

model Mensaje {
  // texto que pertenece a un grupo y puede tener autor o ser del sistema.
  id String       @id @default(cuid())
  idGrupo String @map("groupId")
  idUsuario String? @map("userId")
  type TipoMensaje  @default(USER)
  content String
  tipoContexto TipoContexto? @map("contextType")
  creadoEn DateTime     @default(now()) @db.Timestamptz(3) @map("createdAt")
  group Grupo        @relation(fields: [idGrupo], references: [id], onDelete: Cascade)
  user Usuario?        @relation(fields: [idUsuario], references: [id], onDelete: SetNull)

  @@index([idGrupo, creadoEn])
  @@index([tipoContexto])
  @@map("messages")
}

model Sesion {
  // refresh token representado como hash y vinculado a su rotacion.
  id String    @id @default(cuid())
  idUsuario String @map("userId")
  idFamilia String    @default(cuid()) @map("familyId")
  hashToken String    @unique @map("tokenHash")
  idReemplazo String? @map("replacedById")
  agenteUsuario String? @map("userAgent")
  direccionIp String? @map("ipAddress")
  revocado Boolean   @default(false) @map("isRevoked")
  revocadoEn DateTime? @db.Timestamptz(3) @map("revokedAt")
  ultimoUsoEn DateTime? @db.Timestamptz(3) @map("lastUsedAt")
  venceEn DateTime  @db.Timestamptz(3) @map("expiresAt")
  creadoEn DateTime  @default(now()) @db.Timestamptz(3) @map("createdAt")
  user Usuario      @relation(fields: [idUsuario], references: [id], onDelete: Cascade)

  @@index([idUsuario, revocado])
  @@index([idFamilia])
  @@map("sessions")
}
